Experiments/*
!Experiments/.gitkeep

# Design docs kept local, out of history
docs/

# Temp / rendezvous / logs
tem/
tem_*/
log/
*.log

# Embedded reference repos cloned locally (not part of this repo).
# NB: refs/GCPN and refs/GraphAF ARE tracked content — do not ignore all of refs/.
refs/BDE-db2/
refs/addons/
refs/alfabet/
