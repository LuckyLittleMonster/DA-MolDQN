# Python
__pycache__/
*.pyc

# C++ extension build artifacts
csrc/build*/
csrc/cenv.so
*.sif

# Confidential data — never commit (symlink to private dataset)
Data/anti_400.txt

# Run outputs: contain generated molecules (confidential if from private data).
